{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    // "verbatimModuleSyntax": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /* If transpiling with TypeScript: */
    /* tsc checks and emits nothing; tsup bundles. TypeScript 7 removes the node10 resolution that
       commonjs implied. */
    "module": "preserve",
    "moduleResolution": "bundler",
    "sourceMap": true,
    /* AND if you're building for a library: */
    "declaration": true,
    /* AND if you're building for a library in a monorepo: */
    "composite": true,
    "declarationMap": true,
    /* If your code doesn't run in the DOM: */
    "lib": [
      "es2022"
    ],
    /* TypeScript 6 and later load no @types package unless a config names it. */
    "types": [
      "node"
    ],
    "rootDir": "./src",
    "outDir": "./dist",
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}