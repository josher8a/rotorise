{
	"name": "Rotorise — TypeScript & Lean 4",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
	"onCreateCommand": "curl -sSf https://elan.lean-lang.org/elan-init.sh | sh -s -- -y --default-toolchain none",
	"postCreateCommand": "npm ci && cd formal && lake exe cache get && lake build",
	"remoteEnv": {
		"PATH": "/home/node/.elan/bin:${containerEnv:PATH}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"biomejs.biome",
				"leanprover.lean4"
			]
		}
	}
}
